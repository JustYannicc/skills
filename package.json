{
  "name": "universal-system-thinking-skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm style && pnpm typecheck && pnpm test",
    "evaluations:record": "tsx src/cli.ts record-evaluations",
    "fix": "ultracite fix",
    "prototype:system-record-representation": "tsx prototypes/system-record-representation/run.ts",
    "style": "ultracite check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && tsx src/cli.ts validate"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "smol-toml": "1.7.1",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "ultracite": "7.10.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
